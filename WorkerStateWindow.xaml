<Window x:Class="Resizer.WorkerStateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Resizer"
        xmlns:Utils="clr-namespace:Resizer.CoreUtils"
        mc:Ignorable="d"
        Title="Work in progress..." Height="100" Width="300" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid>
        <ProgressBar x:Name="WorkProgressbar" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="25" Margin="30" Minimum="0" Maximum="100" Value="0" />

    </Grid>
</Window>
